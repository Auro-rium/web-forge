# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Backboard API key (required for live runs; not needed for tests or --mock). You can also paste it in the web UI.
BACKBOARD_API_KEY=your_key_here

# Model routing through Backboard
WEBFORGE_PROVIDER=anthropic
WEBFORGE_MODEL=claude-haiku-5-5

# Hard cap (USD) on cumulative spend, tracked in data/spend.json. LLM calls are refused once reached.
WEBFORGE_BUDGET_USD=3.0

# Per-run budget: wrap-up at 70%, research/browsing refused at 100%
# WEBFORGE_RUN_BUDGET_USD=0.25
# WEBFORGE_RUN_DEADLINE_S=300

# Consequential actions (submit, send, log in, delete): ask (default) | auto | deny. Payments are always blocked.
# WEBFORGE_APPROVAL=ask
# WEBFORGE_ASK_TIMEOUT=90                 # seconds to wait for your answer
# WEBFORGE_VERIFY_ROUNDS=2                # times the verifier may send the planner back
# WEBFORGE_PARALLEL=5                     # concurrent sub-agents / tabs / searches
# WEBFORGE_SCREENSHOTS=1                  # live browser thumbnails in the web UI
# WEBFORGE_CDP_URL=http://127.0.0.1:9222  # drive YOUR Chrome: run `python -m webforge chrome` first
# WEBFORGE_KEEP_TABS=0                    # keep the agent's tabs open after a run (your own Chrome only)

# Secrets for logins: the agent types {{secret:github_pw}}; the value is filled by the browser, never shown to the model
# WEBFORGE_SECRET_GITHUB_PW=...

# Optional
# WEBFORGE_ALLOWED_DOMAINS=example.com,wikipedia.org   # unset = any public website
# WEBFORGE_CHROMIUM=/path/to/chromium     # leave unset to use Playwright's own Chromium
# WEBFORGE_DATA=./data                    # spend ledger, saved key, assistant ids
# WEBFORGE_RUNS=./runs                    # per-run events, checkpoints and deliverables
# WEBFORGE_ACCESS_CODE=                   # server only: header X-Access-Code required to start/control runs
# WEBFORGE_CORS_ORIGINS=                  # server only: comma-separated allowed browser origins
# WEBFORGE_MOCK=1                         # server only: offline MockLLM, no key, no spend
